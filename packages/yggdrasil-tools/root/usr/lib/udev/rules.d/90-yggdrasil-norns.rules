# Les Nornes : quand un disque est branché, le service utilisateur norns-branchement@UUID
# demande à « norns auto » si c'est le disque de sauvegarde (sinon, il ne fait rien).
ACTION=="add", SUBSYSTEM=="block", ENV{ID_FS_UUID}=="?*", ENV{ID_FS_USAGE}=="filesystem", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="norns-branchement@$env{ID_FS_UUID}.service"
