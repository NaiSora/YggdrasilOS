[Unit]
Description=Heimdall, pare-feu d'Yggdrasil
Documentation=man:nft(8) file:///usr/share/doc/yggdrasil/index.html
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=local-fs.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/heimdall apply --boot
ExecReload=/usr/bin/heimdall apply --boot
ExecStop=/usr/bin/heimdall stop
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=sysinit.target
