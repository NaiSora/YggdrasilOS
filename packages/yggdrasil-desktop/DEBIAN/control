Version: @VERSION@
Architecture: all
Maintainer: Projet Yggdrasil <yggdrasil@localhost>
Section: kde
Priority: optional
Depends: yggdrasil-base (= @VERSION@), yggdrasil-tools (= @VERSION@),
 python3-pyside6.qtcore, python3-pyside6.qtgui, python3-pyside6.qtqml, python3-pyside6.qtquick,
 python3-pyside6.qtwidgets, qml6-module-org-kde-kirigami, qml6-module-qtquick-controls,
 qml6-module-qtquick-layouts, qml6-module-qtquick-templates, qml6-module-qtquick-window,
 qml6-module-qtqml-workerscript, qml6-module-qtquick-effects, qt6-svg-plugins, librsvg2-bin,
