---
componentName:   yggdrasil
welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 960px,640px
windowPlacement: center

strings:
    productName:         Yggdrasil
    shortProductName:    Yggdrasil
    version:             @VERSION_SHORT@
    shortVersion:        @VERSION_SHORT@
    versionedName:       Yggdrasil @VERSION_SHORT@ « Midgard »
    shortVersionedName:  Yggdrasil @VERSION_SHORT@
    bootloaderEntryName: Yggdrasil
    productUrl:          https://naisora.github.io/YggdrasilOS/
    supportUrl:          https://github.com/NaiSora/YggdrasilOS/issues
    knownIssuesUrl:      https://naisora.github.io/YggdrasilOS/notes.html
