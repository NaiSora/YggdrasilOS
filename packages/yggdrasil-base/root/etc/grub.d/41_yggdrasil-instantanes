#!/bin/sh
# Yggdrasil : les instantanés Timeshift (btrfs) au menu de démarrage (paquet yggdrasil-base).
#
# Quand la racine est en btrfs (sous-volume @, installation Calamares), chaque instantané
# des Nornes devient une entrée « Yggdrasil — revenir à un instantané » : on démarre
# le système tel qu'il était, pour vérifier, puis « norns restore » l'adopte pour de bon.
# Le noyau vient de l'instantané lui-même ; si /boot est à part (installation chiffrée),
# c'est un noyau de /boot dont l'instantané a encore les modules.
# Lancé par update-grub ; ne fait rien sur une racine ext4.
set -e

# shellcheck disable=SC1091
. /usr/share/grub/grub-mkconfig_lib

# Les tests peuvent imposer la racine et /boot (sinon : ceux du système en marche)
SOURCE=${YGG_RACINE_SOURCE:-$(findmnt -n -o SOURCE / 2>/dev/null || true)}
FSTYPE=${YGG_RACINE_FSTYPE:-$(findmnt -n -o FSTYPE / 2>/dev/null || true)}
OPTIONS=${YGG_RACINE_OPTIONS:-$(findmnt -n -o OPTIONS / 2>/dev/null || true)}
BOOT_SOURCE=${YGG_BOOT_SOURCE-$(findmnt -n -o SOURCE /boot 2>/dev/null || true)}
BOOT_DIR=${YGG_BOOT_DIR:-/boot}
MAX=${YGG_INSTANTANES_MAX:-10}

[ "$FSTYPE" = btrfs ] || exit 0
case ",$OPTIONS," in
    *,subvol=/@,*|*,subvol=@,*) ;;
    *) exit 0 ;;
esac
DEVICE=${SOURCE%%\[*}
UUID=$(blkid -s UUID -o value "$DEVICE" 2>/dev/null || true)
[ -n "$UUID" ] || exit 0

POINT=$(mktemp -d)
if ! mount -o ro,subvolid=5 "$DEVICE" "$POINT" 2>/dev/null; then
    rmdir "$POINT"
    exit 0
fi
trap 'umount "$POINT"; rmdir "$POINT"' EXIT

INSTANTANES=$POINT/timeshift-btrfs/snapshots
[ -d "$INSTANTANES" ] || exit 0
# Les plus récents d'abord (noms : 2026-10-02_10-00-01)
LISTE=$(find "$INSTANTANES" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -r | head -n "$MAX")
[ -n "$LISTE" ] || exit 0

# Comment GRUB atteint le volume (modules, déverrouillage éventuel), puis le volume lui-même
# désigné par son UUID : la recherche explicite ne dépend pas de ce que grub-probe a su dire.
acces() { # acces PÉRIPHÉRIQUE UUID
    { prepare_grub_to_access_device "$1" 2>/dev/null || true
      echo "search --no-floppy --fs-uuid --set=root $2"; } | sed 's/^/\t\t/'
}
ACCES_RACINE=$(acces "$DEVICE" "$UUID")
BOOT_DEVICE=${BOOT_SOURCE%%\[*}
ACCES_BOOT=""
if [ -n "$BOOT_DEVICE" ]; then
    BOOT_UUID=$(blkid -s UUID -o value "$BOOT_DEVICE" 2>/dev/null || true)
    [ -z "$BOOT_UUID" ] || ACCES_BOOT=$(acces "$BOOT_DEVICE" "$BOOT_UUID")
fi

ENTREES=""
NOMBRE=0
for NOM in $LISTE; do
    case "$NOM" in *[!0-9_-]*) continue ;; esac  # un nom inattendu n'entre pas dans grub.cfg
    RACINE=$INSTANTANES/$NOM/@
    NOYAU=$(find "$RACINE/boot" -maxdepth 1 -name 'vmlinuz-*' -printf '%f\n' 2>/dev/null | sort -V | tail -n 1)
    if [ -n "$NOYAU" ]; then
        # /boot dans la racine : le noyau de l'instantané, par son chemin dans le volume
        VERSION=${NOYAU#vmlinuz-}
        [ -f "$RACINE/boot/initrd.img-$VERSION" ] || continue
        ACCES=$ACCES_RACINE
        CHEMIN=/timeshift-btrfs/snapshots/$NOM/@/boot
    elif [ -n "$ACCES_BOOT" ]; then
        # /boot à part : le plus récent noyau de /boot dont l'instantané a les modules
        VERSION=""
        for V in $(find "$BOOT_DIR" -maxdepth 1 -name 'vmlinuz-*' -printf '%f\n' 2>/dev/null \
                   | sed 's/^vmlinuz-//' | sort -rV); do
            if [ -d "$RACINE/usr/lib/modules/$V" ] || [ -d "$RACINE/lib/modules/$V" ]; then
                if [ -f "$BOOT_DIR/initrd.img-$V" ]; then VERSION=$V; break; fi
            fi
        done
        [ -n "$VERSION" ] || continue
        ACCES=$ACCES_BOOT
        CHEMIN=""
    else
        continue
    fi
    # 2026-10-02_10-00-01 → 2026-10-02 à 10:00
    QUAND=$(echo "$NOM" | sed -n 's/^\([0-9-]\{10\}\)_\([0-9]\{2\}\)-\([0-9]\{2\}\).*/\1 à \2:\3/p')
    COMMENTAIRE=$(sed -n 's/.*"comments" *: *"\([^"]*\)".*/\1/p' "$INSTANTANES/$NOM/info.json" 2>/dev/null \
        | tr -d "'\\\\" | cut -c1-50)
    TITRE="${QUAND:-$NOM}${COMMENTAIRE:+ — $COMMENTAIRE}"
    ENTREES="$ENTREES
	menuentry '$TITRE' --class yggdrasil --class os {
$ACCES
		echo \"Retour à l'instantané du $TITRE…\"
		linux $CHEMIN/vmlinuz-$VERSION root=UUID=$UUID rw rootflags=subvol=timeshift-btrfs/snapshots/$NOM/@ quiet
		initrd $CHEMIN/initrd.img-$VERSION
	}"
    NOMBRE=$((NOMBRE + 1))
done
[ -n "$ENTREES" ] || exit 0

echo "Instantanés d'Yggdrasil au menu : $NOMBRE" >&2
cat << EOF
submenu 'Yggdrasil — revenir à un instantané' --class yggdrasil {$ENTREES
}
EOF
